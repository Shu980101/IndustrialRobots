<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

    <link name="base_camera_link">
        <inertial>
            <origin xyz="-0.00936000000 -0.00003000000 -0.00273000000" rpy="0 0 0"/>
            <mass value="0.21970000000"/>
            <inertia ixx="0.00000429247" ixy="0.00000000000" ixz="0.00000002565"
                    iyy="0.00000008027" iyz="0.00000000000"
                    izz="0.00000427339"/>
        </inertial>
        <visual>
            <geometry>
                <mesh filename="file://$(find ros2srrc_ur5_gazebo)/meshes/kinetic.stl"/>
            </geometry>
            <material name="dark_grey"/>
        </visual>
        <collision>
            <geometry>
                <mesh filename="file://$(find ros2srrc_ur5_gazebo)/meshes/kinetic.dae"/>
            </geometry>
        </collision>
    </link>

    <!-- frames in the center of the camera -->
    <joint name="base_camera_joint" type="fixed">
        <parent link="${parent_base}"/>
        <child link="base_camera_link"/>
        <origin xyz="${cam_base_px} ${cam_base_py} ${cam_base_pz}" 
            rpy="${cam_base_or} ${cam_base_op} ${cam_base_oy}"/>
    </joint>

    <link name="base_camera_optical_link"></link>

    <joint name="base_camera_optical_joint" type="fixed">
        <parent link="base_camera_link"/>
        <child link="base_camera_optical_link"/>
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <!-- CHANGED: replaced libgazebo_ros_camera.so (Classic) with native Gazebo Harmonic depth sensor -->
    <!-- Topics are bridged to ROS 2 via ros_gz_bridge in the launch file:                          -->
    <!--   /base_camera/depth/image_raw  -> sensor_msgs/msg/Image                                   -->
    <!--   /base_camera/color/image_raw  -> sensor_msgs/msg/Image                                   -->
    <!--   /base_camera/points           -> sensor_msgs/msg/PointCloud2                             -->
    <gazebo reference="base_camera_link">
        <sensor name="base_camera" type="rgbd_camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>1</always_on>
            <update_rate>10</update_rate>
            <visualize>true</visualize>
            <topic>base_camera</topic>
            <gz_frame_id>base_camera_optical_link</gz_frame_id>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <format>R8G8B8</format>
                    <width>640</width>
                    <height>480</height>
                </image>
                <clip>
                    <near>0.05</near>
                    <far>8</far>
                </clip>
            </camera>
        </sensor>
    </gazebo>

</robot>
